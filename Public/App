/* ═══════════════════════════════════════════════════════════════
   Muslim Chess — Frontend App
   Requires: Socket.IO (from server), chess.js (CDN loaded inline)
═══════════════════════════════════════════════════════════════ */

// Load chess.js dynamically then boot the app
(function loadDeps() {
  const s = document.createElement('script');
  s.src = 'https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.13.4/chess.min.js';
  s.onload = () => initApp();
  s.onerror = () => {
    // fallback — use a bundled stub for pure UI if needed
    console.warn('chess.js CDN failed, retrying...');
    const s2 = document.createElement('script');
    s2.src = 'https://unpkg.com/chess.js@0.13.4/chess.min.js';
    s2.onload = () => initApp();
    document.head.appendChild(s2);
  };
  document.head.appendChild(s);
})();

function initApp() {

