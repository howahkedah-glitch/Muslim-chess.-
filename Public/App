const PIECE_UNICODE = { p:'♟',r:'♜',n:'♞',b:'♝',q:'♛',k:'♚' };

// ── Helpers ────────────────────────────────────────────────────
function formatTime(secs) {
  const m = Math.floor(secs / 60);
  const s = secs % 60;
  return `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
}

function showToast(msg, duration = 2500) {
  const t = $('toast');
  t.textContent = msg;
  t.classList.remove('hidden');
  clearTimeout(t._tid);
  t._tid = setTimeout(() => t.classList.add('hidden'), duration);
}

function sqToIndex(sq, flipped) {
  const file = sq.charCodeAt(0) - 97; // a=0
  const rank = parseInt(sq[1]) - 1;   // 1=0
  if (flipped) {
    return (rank * 8) + (7 - file);
  } else {
    return ((7 - rank) * 8) + file;
  }
}

function indexToSq(idx, flipped) {
  let file, rank;
  if (flipped) {
    file = 7 - (idx % 8);
    rank = Math.floor(idx / 8);
  } else {
    file = idx % 8;
    rank = 7 - Math.floor(idx / 8);
  }
  return String.fromCharCode(97 + file) + (rank + 1);
}

// ── Board Sizing ───────────────────────────────────────────────
function getBoardSize() {
  const vw = window.innerWidth;
  const vh = window.innerHeight;
  if (vw <= 700) {
    // Mobile: board takes full width minus padding, minus player bars (~100px), minus gap
    return Math.min(vw - 16, vh - 200);
  } else {
    // Desktop: board = height minus player bars (2x52px) minus gaps
    return Math.min(vh - 140, vw * 0.58, 600);
  }
}

// ── Board Rendering ────────────────────────────────────────────
function renderBoard() {
  const board = $('chess-board');
  const size = getBoardSize();
  board.style.width = size + 'px';
  board.style.height = size + 'px';
  board.style.gridTemplateColumns = 'repeat(8, 1fr)';

  const chess = state.chess;
  const pos = chess.board();
  const flipped = state.boardFlipped;

  // Compute legal move targets for selected square
  const hints = new Set();
  if (state.selectedSq && !state.isSpectator) {
    state.legalMoves.forEach(m => hints.add(m.to));
  }

  // Find king in check
  let checkKingSq = null;
  if (chess.inCheck()) {
    const turn = chess.turn();
    for (let r = 0; r < 8; r++) for (let f = 0; f < 8; f++) {
      const p = pos[r][f];
      if (p && p.type === 'k' && p.color === turn) {
        checkKingSq = String.fromCharCode(97 + f) + (8 - r);
      }
    }
  }

  board.innerHTML = '';

  for (let i = 0; i < 64; i++) {
    const sq = indexToSq(i, flipped);
    const file = sq.charCodeAt(0) - 97;
    const rank = parseInt(sq[1]) - 1;
    const r = 7 - rank; // row in pos array
    const piece = pos[r][file];

    const div = document.createElement('div');
    div.className = 'sq ' + ((file + rank) % 2 === 0 ? 'dark' : 'light');
    div.dataset.sq = sq;

    // Coordinate labels
    if (rank === (flipped ? 7 : 0)) {
      const fLabel = document.createElement('span');
      fLabel.className = 'coord coord-file';
      fLabel.textContent = String.fromCharCode(97 + file);
      div.appendChild(fLabel);
    }
    if (file === (flipped ? 7 : 0)) {
      const rLabel = document.createElement('span');
      rLabel.className = 'coord coord-rank';
      rLabel.textContent = rank + 1;
      div.appendChild(rLabel);
    }

    // Highlight last move
    if (state.lastMove && (sq === state.lastMove.from || sq === state.lastMove.to)) {
      div.classList.add('last-move');
    }

    // Selected
    if (state.selectedSq === sq) div.classList.add('selected');

    // Check highlight
    if (checkKingSq === sq) div.classList.add('in-check');

    // Move hints
    if (hints.has(sq)) {
      div.classList.add(piece ? 'hint-capture' : 'hint');
    }

    // Piece
    if (piece) {
      const key = piece.color + piece.type.toUpperCase();
      const img = document.createElement('div');
      img.className = 'piece';
      img.innerHTML = PIECE_SVG[key] || '';
      div.appendChild(img);
    }

    div.addEventListener('click', () => onSquareClick(sq));
    board.appendChild(div);
  }
}

function onSquareClick(sq) {
  if (state.isSpectator) return;
  if (state.pendingPromotion) return;
  if (!state.roomState || state.roomState.status !== 'playing') return;

  const chess = state.chess;
  const myColor = state.myColor;
  if (chess.turn() !== myColor) return;

  const piece = chess.get(sq);

  if (state.selectedSq) {
    // Try to move
    if (state.selectedSq === sq) {
      // Deselect
      state.selectedSq = null;
      state.legalMoves = [];
      renderBoard();
      return;
    }

    const move = state.legalMoves.find(m => m.to === sq);
    if (move) {
      // Check promotion
      if (move.flags.includes('p')) {
        showPromotionModal(state.selectedSq, sq, myColor);
        return;
      }
      sendMove({ from: state.selectedSq, to: sq });
      state.selectedSq = null;
      state.legalMoves = [];
      return;
    }

    // Click on own piece — switch selection
    if (piece && piece.color === myColor) {
      selectSquare(sq);
      return;
    }

    state.selectedSq = null;
    state.legalMoves = [];
    renderBoard();
    return;
  }

  if (piece && piece.color === myColor) {
    selectSquare(sq);
  }
}

function selectSquare(sq) {
  state.selectedSq = sq;
  state.legalMoves = state.chess.moves({ square: sq, verbose: true });
  renderBoard();
}

function sendMove(moveObj) {
  state.socket.emit('make_move', { move: moveObj });
  // Optimistic: apply locally
  try {
    const result = state.chess.move(moveObj);
    if (result) {
      state.lastMove = { from: moveObj.from, to: moveObj.to };
      renderBoard();
    }
  } catch {}
}

// ── Promotion ──────────────────────────────────────────────────
function showPromotionModal(from, to, color) {
  state.pendingPromotion = { from, to };
  const modal = $('promotion-modal');
  const piecesDiv = $('promotion-pieces');
  piecesDiv.innerHTML = '';
  ['q','r','b','n'].forEach(type => {
    const btn = document.createElement('button');
    btn.className = 'promo-piece-btn';
    const key = color + type.toUpperCase();
    btn.innerHTML = PIECE_SVG[key] || '';
    btn.title = type;
    btn.addEventListener('click', () => {
      sendMove({ from, to, promotion: type });
      state.pendingPromotion = null;
      modal.classList.add('hidden');
      state.selectedSq = null;
      state.legalMoves = [];
    });
    piecesDiv.appendChild(btn);
  });
  modal.classList.remove('hidden');
}

// ── Player Bars ────────────────────────────────────────────────
function updatePlayerBars(roomState) {
  const myColor = state.myColor;
  // Determine top/bottom: my color at bottom
  const bottomColor = myColor || 'w';
  const topColor = bottomColor === 'w' ? 'b' : 'w';
  state.boardFlipped = myColor === 'b';

  const players = Object.values(roomState.players);
  const topPlayer = players.find(p => p.color === topColor);
  const bottomPlayer = players.find(p => p.color === bottomColor);

  function setBar(barId, nameId, timerId, avatarId, capturedId, player, color) {
    const bar = $(barId);
    const isActive = roomState.activeColor === color && roomState.status === 'playing';
    bar.classList.toggle('active-turn', isActive);

    $(nameId).textContent = player ? player.name + (player.disconnected ? ' (منقطع)' : '') : '—';
    const timeEl = $(timerId);
    timeEl.textContent = player ? formatTime(player.timeLeft) : '10:00';
    timeEl.classList.toggle('low', player ? player.timeLeft <= 30 : false);

    // Captured pieces
    const capturedEl = $(capturedId);
    capturedEl.innerHTML = '';
    if (roomState.capturedPieces) {
      const captured = roomState.capturedPieces[color] || [];
      captured.forEach(p => {
        const span = document.createElement('span');
        span.textContent = PIECE_UNICODE[p] || p;
        capturedEl.appendChild(span);
      });
    }
  }

  setBar('player-bar-top', 'name-top', 'timer-top', 'avatar-top', 'captured-top', topPlayer, topColor);
  setBar('player-bar-bottom', 'name-bottom', 'timer-bottom', 'avatar-bottom', 'captured-bottom', bottomPlayer, bottomColor);
}

// ── Move History ───────────────────────────────────────────────
function updateMoveHistory(moveHistory) {
  const list = $('moves-list');
  list.innerHTML = '';
  for (let i = 0; i < moveHistory.length; i++) {
    const m = moveHistory[i];
    const div = document.createElement('div');
    div.className = 'move-entry ' + (m.color === 'w' ? 'white-move' : 'black-move');
    if (i === moveHistory.length - 1) div.classList.add('current');
    if (m.color === 'w') {
      const numSpan = document.createElement('span');
      numSpan.style.color = 'var(--text-dim)';
      numSpan.style.marginLeft = '4px';
      numSpan.textContent = Math.floor(i/2+1) + '.';
      div.prepend(numSpan);
    }
    div.appendChild(document.createTextNode(' ' + m.san));
    list.appendChild(div);
  }
  list.scrollTop = list.scrollHeight;
}

// ── Apply Room State ───────────────────────────────────────────
function applyRoomState(roomState) {
  state.roomState = roomState;

  // Sync local chess
  if (!state.chess) state.chess = typeof Chess !== 'undefined' ? new Chess() : null;
  if (state.chess) {
    try { state.chess.load(roomState.fen); } catch {}
  }

  if (roomState.moveHistory.length > 0) {
    const last = roomState.moveHistory[roomState.moveHistory.length - 1];
    state.lastMove = { from: last.from, to: last.to };
  }

  updatePlayerBars(roomState);
  if (state.chess) renderBoard();
  updateMoveHistory(roomState.moveHistory);
}

// ── Chat ───────────────────────────────────────────────────────
function addChatMessage(msg, isSystem = false) {
  const container = $('chat-messages');
  const div = document.createElement('div');
  div.className = 'chat-msg' + (isSystem ? ' system' : '');
  if (!isSystem) {
    const sender = document.createElement('span');
    sender.className = 'sender';
    sender.textContent = msg.name;
    div.appendChild(sender);
  }
  const text = document.createElement('span');
  text.className = 'text';
  text.textContent = isSystem ? msg : msg.message;
  div.appendChild(text);
  container.appendChild(div);
  container.scrollTop = container.scrollHeight;
}

// ── Game Over ──────────────────────────────════════════════════
const resultMessages = {
  checkmate: (r) => ({ title: r.winner === state.myColor ? '🏆 فزت!' : '💔 خسرت', sub: 'كش ملك' }),
  stalemate: () => ({ title: '🤝 تعادل', sub: 'تعادل - لا حركات ممكنة' }),
  draw:      () => ({ title: '🤝 تعادل', sub: 'تعادل بالاتفاق' }),
  timeout:   (r) => ({ title: r.winner === state.myColor ? '🏆 فزت!' : '💔 خسرت', sub: 'انتهى الوقت' }),
  resign:    (r) => ({ title: r.winner === state.myColor ? '🏆 فزت!' : '💔 خسرت', sub: 'الخصم استسلم' }),
  disconnect:(r) => ({ title: r.winner === state.myColor ? '🏆 فزت!' : '💔 خسرت', sub: 'الخصم غادر المباراة' }),
};

function showGameOver(result) {
  const handler = resultMessages[result.type];
  const { title, sub } = handler ? handler(result) : { title: 'انتهت المباراة', sub: '' };
