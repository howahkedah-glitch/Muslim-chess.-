const state = {
  socket: null,
  roomCode: null,
  myColor: null,        // 'w' | 'b' | null (spectator)
  playerName: '',
  chess: null,          // local chess.js for rendering
  selectedSq: null,
  legalMoves: [],
  lastMove: null,       // { from, to }
  boardFlipped: false,
  isSpectator: false,
  roomState: null,
  pendingPromotion: null,
};

